{
  "name": "boilerplate-scaffold",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "bun dist/server/server.js",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e:api": "bun run db:migrate && bun run build && bun test e2e/api",
    "test:e2e:browser": "bun run build && playwright test",
    "test:e2e": "bun run test:e2e:api && bun run test:e2e:browser",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts",
    "agents:setup": "bun scripts/setup-agent-plugins.ts",
    "agents:update": "bun scripts/update-agent-plugins.ts"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.38",
    "@tanstack/router-plugin": "1.168.26",
    "@vite-env/core": "0.6.4",
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "valibot": "1.4.2",
    "vite-env-only": "3.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.1",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "1.167.24",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
