{
  "name": "self-service-web-checkout",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src scripts",
    "build:e2e:abandonment": "VITE_CART_IDLE_TIMEOUT_MS=15000 VITE_CART_IDLE_COUNTDOWN_SECONDS=3 VITE_TERMINAL_DELAY_MS=300 VITE_POSTHOG_KEY=phc_test VITE_POSTHOG_HOST=http://posthog.test bun run build && rm -rf .output-e2e-abandonment && cp -R .output .output-e2e-abandonment",
    "build:e2e:core": "VITE_CART_IDLE_TIMEOUT_MS=86400000 VITE_CART_IDLE_COUNTDOWN_SECONDS=3 VITE_TERMINAL_DELAY_MS=300 VITE_POSTHOG_KEY=phc_test VITE_POSTHOG_HOST=http://posthog.test bun run build && rm -rf .output-e2e-core && cp -R .output .output-e2e-core",
    "test:e2e:abandonment": "bun scripts/reset-db.ts && bun run db:migrate && bun run db:seed && bun run build:e2e:abandonment && PW_PROJECT=abandonment playwright test",
    "test:e2e:core": "bun scripts/reset-db.ts && bun run db:migrate && bun run db:seed && bun run build:e2e:core && PW_PROJECT=core playwright test",
    "test:e2e": "bun run test:e2e:core && bun run test:e2e:abandonment",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun scripts/seed.ts",
    "agents:setup": "bun scripts/setup-agent-plugins.ts",
    "agents:update": "bun scripts/update-agent-plugins.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5",
    "@libsql/client": "0.17.4",
    "@posthog/react": "1.10.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.38",
    "@tanstack/router-plugin": "1.168.26",
    "@vite-env/core": "0.6.4",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.30.0",
    "nitro": "3.0.260610-beta",
    "posthog-js": "1.413.3",
    "posthog-node": "^5.48.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "valibot": "1.4.2",
    "vite-env-only": "3.0.3",
    "yargs": "18.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@playwright/test": "1.62.1",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "1.167.24",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/yargs": "17.0.35",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
